{
  "name": "woorden",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Woorden NG: an offline Dutch vocabulary trainer for the web (PWA) and Android, redeveloped from iamsergeyka/woorden. Codex implements, Claude reviews, the owner merges.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "npm run build:web && npm run build:android",
    "build:web": "vite build --mode web",
    "build:android": "vite build --mode android",
    "preview": "vite preview --mode web --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:web",
    "test:e2e:web": "playwright test",
    "test:e2e:android": "playwright test --config playwright.android.config.ts --grep-invert @repositories",
    "test:repositories:android": "playwright test --config playwright.android.config.ts --grep @repositories",
    "content:validate": "node tools/content/extract-legacy-seed.mjs --validate",
    "check:tasks": "node scripts/check-tasks.mjs --strict-refs",
    "next:task": "node scripts/next-task.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run check:tasks && npm run --if-present content:validate",
    "android:sync": "npm run build:android && cap sync android",
    "rename-app": "node scripts/rename-app.mjs",
    "test:repositories:web": "vitest run tests/integration/repositories/web.test.ts tests/integration/repositories/learning-web.test.ts",
    "content:apertium": "node tools/content/import-apertium.mjs",
    "content:odwn": "node tools/content/import-odwn.mjs",
    "content:validate-entry": "node tools/content/validate-entry.mjs",
    "content:sources": "node tools/content/inspect-source.mjs",
    "content:nt2lex": "node tools/content/import-nt2lex.mjs",
    "content:spelling": "node tools/content/opentaal-spelling.mjs",
    "content:subtlex": "node tools/content/import-subtlex.mjs",
    "content:import-drafts": "node tools/content/import-drafts.mjs",
    "content:sample": "node tools/content/sample-check.mjs",
    "content:import-sample": "node tools/content/import-sample-check.mjs",
    "content:compile": "node tools/content/compile-pack.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@js-temporal/polyfill": "0.5.1",
    "dexie": "4.2.1",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "4.4.0",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "saxes": "^6.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "config": {
    "playwrightBrowsers": "chromium"
  }
}
