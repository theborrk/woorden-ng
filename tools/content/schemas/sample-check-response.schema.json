{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:woorden:sample-check-response:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "batch_manifest_sha256",
    "seed",
    "reviewer",
    "verdicts"
  ],
  "properties": {
    "schema_version": {
      "const": "woorden-sample-response-1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model_id", "run_ref"],
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "run_ref": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content_sha256", "verdict"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "enum": ["pass", "fix", "unsure"]
          },
          "question": {
            "enum": ["meaning_translation", "dutch", "exercise"]
          },
          "problem_type": {
            "type": "string",
            "minLength": 1
          },
          "patches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["op", "path"],
              "properties": {
                "op": {
                  "enum": ["add", "remove", "replace"]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/(?:[^~]|~[01])*$"
                },
                "value": {}
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "op": {
                        "enum": ["add", "replace"]
                      }
                    }
                  },
                  "then": {
                    "required": ["value"]
                  }
                }
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "fix"
                }
              }
            },
            "then": {
              "required": ["question", "problem_type", "patches"]
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "unsure"
                }
              }
            },
            "then": {
              "required": ["reason"]
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": ["patches"]
                  },
                  {
                    "required": ["problem_type"]
                  },
                  {
                    "required": ["question"]
                  },
                  {
                    "required": ["reason"]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
