{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:woorden:sense-entry:0.2",
  "title": "Woorden sense-entry exchange",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "language",
    "learner_locales",
    "entries",
    "publication_eligible",
    "entry_count",
    "notice"
  ],
  "properties": {
    "schema_version": {
      "const": "woorden-content-research-0.2"
    },
    "pack_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string"
    },
    "language": {
      "const": "nl-NL"
    },
    "learner_locales": {
      "type": "array",
      "items": {
        "enum": ["pl", "en"]
      },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "publication_eligible": {
      "type": "boolean"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "notice": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locales": {
      "type": "object",
      "required": ["en", "pl"],
      "properties": {
        "en": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "pl": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "required": ["start", "end", "text"],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "form": {
      "type": "object",
      "required": ["id", "surface", "features", "source_ids", "status", "grading_enabled", "scope"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "surface": {
          "type": "string"
        },
        "features": {
          "type": "object",
          "required": ["kind", "source_tags"],
          "properties": {
            "kind": {
              "enum": ["verb", "adjective", "plural", "diminutive"]
            },
            "source_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "source_selector": {
          "type": "string"
        },
        "status": {
          "const": "source_verified"
        },
        "grading_enabled": {
          "type": "boolean"
        },
        "scope": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "required": [
        "id",
        "nl",
        "translations",
        "answer_spans",
        "offset_unit",
        "target_sense_id",
        "target_form_ids",
        "accepted_answers",
        "context",
        "task_contract",
        "difficulty",
        "review_status",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nl": {
          "$ref": "#/$defs/text"
        },
        "translations": {
          "$ref": "#/$defs/locales"
        },
        "answer_spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "offset_unit": {
          "const": "UTF-16-code-units"
        },
        "target_sense_id": {
          "$ref": "#/$defs/id"
        },
        "target_form_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "accepted_answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ordered_segments", "case_sensitive"],
            "properties": {
              "ordered_segments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "case_sensitive": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "context": {
          "$ref": "#/$defs/locales"
        },
        "task_contract": {
          "type": "object"
        },
        "difficulty": {
          "enum": ["A1", "A2", "B1", "B2"]
        },
        "review_status": {
          "enum": ["generated_draft", "ai_reviewed", "flagged"]
        },
        "provenance": {
          "type": "object"
        },
        "prerequisites": {
          "type": "object"
        },
        "cue": {
          "type": "object",
          "required": ["mode", "gloss"],
          "properties": {
            "mode": {
              "enum": ["fill_in", "production"]
            },
            "gloss": {
              "$ref": "#/$defs/locales"
            },
            "tense": {
              "$ref": "#/$defs/text"
            },
            "person": {
              "$ref": "#/$defs/text"
            },
            "adjective_use": {
              "enum": ["predicative", "attributive"]
            }
          },
          "additionalProperties": false
        },
        "self_graded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_ids", "method", "status"],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "source_verified",
            "generated_draft",
            "missing",
            "not_applicable",
            "candidate_only",
            "recorded"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "fixture_ref",
        "revision",
        "lexeme",
        "sense",
        "forms",
        "examples",
        "cefr",
        "frequency",
        "curriculum",
        "image_suitability",
        "hints",
        "media",
        "legacy",
        "provenance",
        "sources",
        "generation",
        "review",
        "content_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "woorden-content-research-0.2"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "fixture_ref": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "lexeme": {
          "type": "object",
          "required": [
            "id",
            "lemma",
            "display",
            "pos",
            "source_pos",
            "variants",
            "pronunciation",
            "morphology"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "lemma": {
              "$ref": "#/$defs/text"
            },
            "display": {
              "$ref": "#/$defs/text"
            },
            "pos": {
              "enum": [
                "noun",
                "verb",
                "adj",
                "adv",
                "pron",
                "det",
                "conj",
                "prep",
                "num",
                "intj",
                "phrase",
                "abbrev",
                "name"
              ]
            },
            "source_pos": {
              "type": "string"
            },
            "variants": {
              "type": "array"
            },
            "pronunciation": {
              "type": "object",
              "required": [
                "ipa",
                "ipa_status",
                "polish_approximation",
                "polish_approximation_status"
              ],
              "properties": {
                "ipa": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["ipa", "source_ids", "status"],
                    "properties": {
                      "ipa": {
                        "$ref": "#/$defs/text"
                      },
                      "source_ids": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "const": "source_verified"
                      }
                    }
                  }
                },
                "ipa_status": {
                  "enum": ["source_verified", "missing"]
                },
                "polish_approximation": {
                  "type": ["string", "null"]
                },
                "polish_approximation_status": {
                  "type": "string"
                }
              }
            },
            "morphology": {
              "type": "object",
              "required": ["noun", "verb"],
              "properties": {
                "noun": {
                  "type": ["object", "null"]
                },
                "verb": {
                  "type": ["object", "null"]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "sense": {
          "type": "object",
          "required": [
            "id",
            "lexeme_id",
            "definition_nl",
            "meanings",
            "register",
            "source_sense",
            "usage_notes",
            "component_lemmas",
            "confusion_links"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "lexeme_id": {
              "$ref": "#/$defs/id"
            },
            "definition_nl": {
              "$ref": "#/$defs/text"
            },
            "meanings": {
              "type": "object",
              "required": ["en", "pl"],
              "properties": {
                "en": {
                  "type": ["array", "null"],
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                },
                "pl": {
                  "type": ["array", "null"],
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "register": {
              "type": "string"
            },
            "source_sense": {
              "type": "object"
            },
            "usage_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "component_lemmas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confusion_links": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sense_id", "type"],
                "properties": {
                  "sense_id": {
                    "$ref": "#/$defs/id"
                  },
                  "type": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/form"
          }
        },
        "examples": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "cefr": {
          "type": "object",
          "required": ["estimated", "status", "source_exposure"],
          "properties": {
            "estimated": {
              "enum": ["A1", "A2", "B1", "B2"]
            },
            "status": {
              "const": "editorial_estimate"
            },
            "source_exposure": {
              "type": "array"
            }
          }
        },
        "frequency": {
          "type": "object",
          "required": [
            "source",
            "unit",
            "word",
            "zipf",
            "surface_count",
            "contextual_diversity",
            "lemma_count",
            "lemma_pos",
            "status",
            "note"
          ],
          "properties": {
            "zipf": {
              "type": ["number", "null"]
            },
            "surface_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "lemma_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "status": {
              "enum": ["source_verified", "missing"]
            }
          }
        },
        "curriculum": {
          "type": "object"
        },
        "image_suitability": {
          "type": "object"
        },
        "hints": {
          "type": "object"
        },
        "media": {
          "type": "object"
        },
        "legacy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["legacy_id", "original_ru", "original_en", "mapping"],
            "properties": {
              "legacy_id": {
                "type": "string",
                "pattern": "^s[0-9]+$"
              },
              "original_ru": {
                "type": "string"
              },
              "original_en": {
                "type": "string"
              },
              "mapping": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/evidence"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "family", "url", "excerpt_path", "record_sha256", "retrieved_at"],
            "properties": {
              "id": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "url": {
                "type": ["string", "null"]
              },
              "excerpt_path": {
                "type": "string"
              },
              "record_sha256": {
                "$ref": "#/$defs/hash"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "generation": {
          "type": "object"
        },
        "review": {
          "type": "object",
          "required": ["statuses", "risk_categories", "verification_log", "unresolved_doubts"],
          "properties": {
            "statuses": {
              "type": "object",
              "required": ["ai_review", "release"],
              "properties": {
                "ai_review": {
                  "enum": ["not_run", "ai_reviewed", "revision_requested", "uncertain"]
                },
                "release": {
                  "enum": ["blocked", "eligible"]
                }
              }
            }
          }
        },
        "content_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    }
  }
}
